# --- IBM watsonx ---
WATSONX_APIKEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=mistralai/mistral-medium-2505

# --- App settings ---
CHAT_TURNS_LIMIT=3
QR_TEXT=

# --- Milvus for RAG ---
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=instana_docs

# --- Instana Generative AI Observability ---
# Instana 플러그인 활성화 (필수)
OTEL_RESOURCE_ATTRIBUTES=INSTANA_PLUGIN=genai

# Traceloop 로깅 및 메트릭 설정
TRACELOOP_LOGGING_ENABLED=true
TRACELOOP_METRICS_ENABLED=true

# Instana 백엔드 엔드포인트 (사용자가 설정해야 함)
# 예: https://your-instana-backend.com:4317
TRACELOOP_BASE_URL=

# OTLP Exporter 설정
# Instana 백엔드가 TLS를 사용하지 않는 경우 true로 설정
OTEL_EXPORTER_OTLP_INSECURE=true

# 선택적: Instana 백엔드 인증 (필요한 경우)
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer YOUR_API_KEY